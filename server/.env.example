# ===== Obrigatórias em produção =====
# Segredo para assinar tokens de sessão (mín. 32 caracteres aleatórios)
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Senha de acesso à central do operador
OPERATOR_PASSWORD=troque-esta-senha
# Origens autorizadas (URL do frontend na Vercel), separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173,https://seu-projeto.vercel.app
NODE_ENV=production

# ===== Opcionais =====
PORT=8787
SESSION_TTL_HOURS=12
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ===== TURN — escolha UMA das opções =====
# Opção A: Metered.ca (plano gratuito disponível)
# METERED_DOMAIN=seuapp.metered.live
# METERED_API_KEY=sua-chave
# Opção B: coturn próprio com credenciais temporárias (static-auth-secret)
# TURN_URLS=turn:turn.seudominio.com:3478?transport=udp,turns:turn.seudominio.com:5349?transport=tcp
# TURN_STATIC_AUTH_SECRET=segredo-do-coturn
# Opção C: credenciais fixas de qualquer provedor TURN
# TURN_URLS=turn:provedor.com:3478
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha
